{
  "schemaVersion": 1,
  "providers": [
    {
      "id": "anichin",
      "name": "Anichin",
      "endpoint": "https://anichin.moe",
      "source": "generic_html",
      "capabilities": {
        "supportsEpisodes": true,
        "supportsSources": true,
        "supportsSubtitles": false,
        "supportsSkipTimes": false,
        "supportsDownload": false,
        "supportsSearch": false,
        "requiresWebView": false,
        "multiAudio": false,
        "shortLivedStreamUrls": false,
        "countryLocked": null,
        "adultOnly": false
      },
      "category": "general",
      "languages": [
        "id"
      ],
      "subtitleVariants": [
        "sub"
      ],
      "priority": 0,
      "enabled": true
    }
  ],
  "metadata": {
    "name": "Anichin",
    "description": "",
    "author": null,
    "version": "1.0.0",
    "sourceUrl": "https://cfg.anichin.moe/provider.json",
    "fetchedAt": 1794572236040,
    "checksum": null,
    "minAppVersion": "0.1.0",
    "maxAppVersion": null
  },
  "workflows": {
    "search": {
      "name": "search",
      "version": "1.0.0",
      "description": null,
      "steps": [
        {
          "op": "http",
          "id": "search_fetch",
          "params": {
            "method": "GET",
            "url": "https://anichin.moe/",
            "query": {
              "s": "{{query}}"
            }
          },
          "saveAs": "search_response"
        },
        {
          "op": "parse_html",
          "id": "search_parse",
          "params": {
            "input": "{{search_response.body}}"
          },
          "saveAs": "search_document"
        },
        {
          "op": "select",
          "id": "search_titles",
          "params": {
            "input": "search_document",
            "selector": "article.bs > div.bsx > a.tip",
            "mode": "ALL",
            "attribute": "title"
          },
          "saveAs": "search_titles"
        },
        {
          "op": "select",
          "id": "search_urls",
          "params": {
            "input": "search_document",
            "selector": "article.bs > div.bsx > a.tip",
            "mode": "ALL",
            "attribute": "href"
          },
          "saveAs": "search_urls"
        },
        {
          "op": "select",
          "id": "search_images",
          "params": {
            "input": "search_document",
            "selector": "article.bs > div.bsx > a.tip img",
            "mode": "ALL",
            "attribute": "src"
          },
          "saveAs": "search_images"
        }
      ],
      "output": {
        "type": "SEARCH",
        "mapping": {
          "titles": "search_titles",
          "urls": "search_urls",
          "images": "search_images"
        }
      }
    },
    "episodes": {
      "name": "episodes",
      "version": "1.0.0",
      "description": null,
      "steps": [
        {
          "op": "http",
          "id": "episodes_fetch",
          "params": {
            "method": "GET",
            "url": "{{url}}"
          },
          "saveAs": "episodes_response"
        },
        {
          "op": "parse_html",
          "id": "episodes_parse",
          "params": {
            "input": "{{episodes_response.body}}"
          },
          "saveAs": "episodes_document"
        },
        {
          "op": "select",
          "id": "episodes_urls",
          "params": {
            "input": "episodes_document",
            "selector": "div.eplister > ul > li > a",
            "mode": "ALL",
            "attribute": "href"
          },
          "saveAs": "episodes_urls"
        },
        {
          "op": "select",
          "id": "episodes_numbers",
          "params": {
            "input": "episodes_document",
            "selector": "div.eplister > ul > li > a div.epl-num",
            "mode": "ALL"
          },
          "saveAs": "episodes_numbers"
        },
        {
          "op": "select",
          "id": "episodes_titles",
          "params": {
            "input": "episodes_document",
            "selector": "div.eplister > ul > li > a div.epl-title",
            "mode": "ALL"
          },
          "saveAs": "episodes_titles"
        }
      ],
      "output": {
        "type": "EPISODES",
        "mapping": {
          "episodeUrls": "episodes_urls",
          "episodeNumbers": "episodes_numbers",
          "episodeTitles": "episodes_titles"
        }
      }
    },
    "sources": {
      "name": "sources",
      "version": "1.0.0",
      "description": null,
      "steps": [
        {
          "op": "http",
          "id": "sources_fetch",
          "params": {
            "method": "GET",
            "url": "{{url}}"
          },
          "saveAs": "sources_response"
        },
        {
          "op": "parse_html",
          "id": "sources_parse",
          "params": {
            "input": "{{sources_response.body}}"
          },
          "saveAs": "sources_document"
        },
        {
          "op": "select",
          "id": "sources_streams",
          "params": {
            "input": "sources_document",
            "selector": "div#pembed > iframe",
            "mode": "ALL",
            "attribute": "src"
          },
          "saveAs": "sources_streams"
        }
      ],
      "output": {
        "type": "SOURCES",
        "mapping": {
          "streams": "sources_streams"
        }
      }
    }
  },
  "security": {
    "allowedDomains": [
      "anichin.moe"
    ],
    "maxResponseBytes": 1048576,
    "maxRequestsPerRun": 20,
    "connectTimeoutMs": 10000,
    "readTimeoutMs": 15000,
    "totalTimeoutMs": 30000,
    "allowRedirects": true,
    "maxRedirects": 5
  }
}