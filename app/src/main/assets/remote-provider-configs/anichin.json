{
  "schemaVersion": 1,
  "providers": [
    {
      "id": "anichin",
      "name": "Anichin",
      "endpoint": "https://anichin.moe/",
      "source": "generic_html",
      "capabilities": {
        "supportsEpisodes": true,
        "supportsSources": true,
        "supportsSubtitles": false,
        "supportsSkipTimes": false,
        "supportsDownload": false,
        "supportsSearch": true,
        "requiresWebView": true,
        "multiAudio": false,
        "shortLivedStreamUrls": true,
        "countryLocked": null,
        "adultOnly": false
      },
      "category": "donghua",
      "languages": [
        "id"
      ],
      "subtitleVariants": [
        "sub"
      ],
      "priority": 100,
      "enabled": true
    }
  ],
  "metadata": {
    "name": "Anichin Verified Provider",
    "description": "Anichin donghua provider with HTML parsing, Base64 mirror resolution, and embed stream support.",
    "author": "Anilili Community",
    "version": "1.0.0",
    "sourceUrl": "https://anichin.moe/provider.json",
    "fetchedAt": 1794416177,
    "checksum": null,
    "minAppVersion": "0.1.84",
    "maxAppVersion": null
  },
  "security": {
    "allowedDomains": [
      "anichin.moe",
      "ok.ru",
      "mega.nz"
    ],
    "maxResponseBytes": 2097152,
    "maxRequestsPerRun": 12,
    "connectTimeoutMs": 10000,
    "readTimeoutMs": 15000,
    "totalTimeoutMs": 30000,
    "allowRedirects": true,
    "maxRedirects": 3
  },
  "workflows": {
    "search": {
      "name": "Search Anichin title",
      "version": "1.0",
      "description": "Search Anichin by anime/donghua title",
      "steps": [
        {
          "op": "http",
          "id": "search_fetch",
          "params": {
            "method": "GET",
            "url": "https://anichin.moe/",
            "query": {
              "s": "{{query}}"
            }
          },
          "saveAs": "search_response"
        },
        {
          "op": "parse_html",
          "id": "search_parse",
          "params": {
            "input": "{{search_response.body}}"
          },
          "saveAs": "search_document"
        },
        {
          "op": "select",
          "id": "search_titles",
          "params": {
            "input": "search_document",
            "selector": ".listupd article.bs a.tip",
            "attribute": "title",
            "mode": "ALL"
          },
          "saveAs": "search_titles"
        },
        {
          "op": "select",
          "id": "search_links",
          "params": {
            "input": "search_document",
            "selector": ".listupd article.bs a.tip",
            "attribute": "href",
            "mode": "ALL"
          },
          "saveAs": "search_urls"
        },
        {
          "op": "select",
          "id": "search_images",
          "params": {
            "input": "search_document",
            "selector": ".listupd article.bs a.tip img",
            "attribute": "src",
            "mode": "ALL"
          },
          "saveAs": "search_images"
        }
      ],
      "output": {
        "type": "SEARCH",
        "mapping": {
          "titles": "search_titles",
          "urls": "search_urls",
          "images": "search_images"
        }
      }
    },
    "episodes": {
      "name": "Locate anime details and episodes",
      "version": "1.0",
      "description": "Fetch episode list for selected series page",
      "steps": [
        {
          "op": "http",
          "id": "series_page_fetch",
          "params": {
            "method": "GET",
            "url": "{{url}}"
          },
          "saveAs": "series_page_response"
        },
        {
          "op": "parse_html",
          "id": "series_page_parse",
          "params": {
            "input": "{{series_page_response.body}}"
          },
          "saveAs": "series_document"
        },
        {
          "op": "select",
          "id": "episode_urls",
          "params": {
            "input": "series_document",
            "selector": ".eplister li a",
            "attribute": "href",
            "mode": "ALL"
          },
          "saveAs": "episode_urls"
        },
        {
          "op": "select",
          "id": "episode_numbers",
          "params": {
            "input": "series_document",
            "selector": ".eplister li .epl-num",
            "mode": "ALL"
          },
          "saveAs": "episode_numbers"
        },
        {
          "op": "select",
          "id": "episode_titles",
          "params": {
            "input": "series_document",
            "selector": ".eplister li .epl-title",
            "mode": "ALL"
          },
          "saveAs": "episode_titles"
        }
      ],
      "output": {
        "type": "EPISODES",
        "mapping": {
          "episodeUrls": "episode_urls",
          "episodeNumbers": "episode_numbers",
          "episodeTitles": "episode_titles"
        }
      }
    },
    "sources": {
      "name": "Resolve watch stream sources",
      "version": "1.0",
      "description": "Extract stream or embed iframe from episode page",
      "steps": [
        {
          "op": "http",
          "id": "watch_fetch",
          "params": {
            "method": "GET",
            "url": "{{url}}"
          },
          "saveAs": "watch_response"
        },
        {
          "op": "parse_html",
          "id": "watch_parse",
          "params": {
            "input": "{{watch_response.body}}"
          },
          "saveAs": "watch_doc"
        },
        {
          "op": "select",
          "id": "mirror_options",
          "params": {
            "input": "watch_doc",
            "selector": "select.mirror option",
            "attribute": "value",
            "mode": "ALL"
          },
          "saveAs": "raw_mirrors"
        },
        {
          "op": "select",
          "id": "mirror_names",
          "params": {
            "input": "watch_doc",
            "selector": "select.mirror option",
            "mode": "ALL"
          },
          "saveAs": "mirror_labels"
        }
      ],
      "output": {
        "type": "SOURCES",
        "mapping": {
          "streams": "raw_mirrors",
          "servers": "mirror_labels"
        }
      }
    }
  }
}
